# Copy to .env and edit. Loaded by whw.config.Settings (pydantic-settings).

# --- Neo4j (whw-neo4j container, bolt :7691 to avoid clash with 7687/7688) ---
NEO4J_URI=bolt://localhost:7691
NEO4J_USER=neo4j
NEO4J_PASSWORD=whw-dev-password
NEO4J_DATABASE=neo4j

# --- Anthropic / Claude Code headless sub-agents ---
ANTHROPIC_API_KEY=
# Claude Code binary; override if not on PATH.
CLAUDE_CODE_BIN=claude

# --- Audit MCP (whw_mcp) ---
# Embedding backend: "nomic" (sentence-transformers nomic-embed-text-v1.5) or "noop" (zero vector, vector ops skipped).
WHW_EMBEDDING_BACKEND=nomic
WHW_NOMIC_MODEL=nomic-ai/nomic-embed-text-v1.5

# --- Orchestration defaults (overridable by CLI flags) ---
WHW_MAX_PARALLEL=4
WHW_PER_AGENT_BUDGET_USD=0.50
WHW_PER_AGENT_TIMEOUT_S=600
WHW_PER_AGENT_MAX_TURNS=25
WHW_RATE_PER_MIN=8

# --- Paths ---
WHW_RUN_DIR=.whw
WHW_WORKTREE_DIR=/tmp/whw-worktrees
WHW_CACHE_DIR=~/.cache/whw
